# Formulário de aplicação · /aplicacao (blefaroplastia)
#
# Copie este arquivo para .env.local e preencha. O .env.local não vai
# para o git. Sem estas variáveis o formulário funciona normalmente:
# o payload apenas é registrado no console em vez de enviado.

# Webhook do n8n que recebe lead_partial e lead_complete
VITE_TOKA_WEBHOOK_URL=

# Destino do botão da tela de desvio (live/aula). Sem valor, cai na home.
VITE_TOKA_URL_LIVE=
