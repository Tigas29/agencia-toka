# Formulário de aplicação · /aplicacao (blefaroplastia)
#
# Copie para .env.local e preencha. O .env.local não vai para o git.
# Em produção, estas variáveis são cadastradas no painel da Vercel.

# ── Servidor (api/lead.js) ────────────────────────────────────────────
# NÃO usar o prefixo VITE_ aqui: isso faria a variável ir para o bundle
# e o token do Kommo ficaria legível no navegador de quem preenche.
KOMMO_SUBDOMAIN=toka
KOMMO_ACCESS_TOKEN=
KOMMO_PIPELINE_ID=13786499
KOMMO_STATUS_ENTRADA=106373283
KOMMO_STATUS_INVALIDO=109098891

# Opcional: recebe uma cópia crua do payload, para plugar o n8n depois
TOKA_WEBHOOK_ESPELHO=

# ── Navegador ─────────────────────────────────────────────────────────
# Destino do botão da tela de desvio (live/aula). Sem valor, cai na home.
VITE_TOKA_URL_LIVE=
